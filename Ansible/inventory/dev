[jenkins]
jenkins-controller ansible_host=YOUR_JENKINS_IP

[build]
build-agent ansible_host=YOUR_BUILD_AGENT_IP

[deploy]
deploy-agent ansible_host=YOUR_DEPLOY_AGENT_IP

[sonarqube]
sonarqube ansible_host=YOUR_SONARQUBE_IP

[monitoring]
monitoring ansible_host=YOUR_MONITORING_IP

[all:vars]
ansible_user=ec2-user
ansible_ssh_private_key_file=~/.ssh/Projectkey.pem